# Room password required to join. Set your own value in a local .env file.
ROOM_PASSWORD=change-me

# Optional: override the default port (3000).
# PORT=3000

# TURN (coturn) — shared secret must match coturn's static-auth-secret.
# Leave TURN_HOST/TURN_SECRET blank to run with STUN only (local/dev).
TURN_HOST=turn.example.com
TURN_SECRET=
TURN_TTL_SECONDS=3600
